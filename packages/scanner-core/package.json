{
  "name": "@jg-stevan/scanner-core",
  "version": "0.3.0",
  "description": "Motor headless de escaneo de documentos: cámara, detección de bordes, procesado, OCR, calidad y exportación. Sin UI. Browser-only (consume vía bundler).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bunx tsc --project tsconfig.build.json",
    "publish:stage": "bun run build && bun make-publish-package.mjs",
    "prepublishOnly": "bun run build && bunx tsc --noEmit"
  },
  "peerDependencies": {
    "zustand": "^5.0.6"
  },
  "dependencies": {
    "heic2any": "^0.0.4",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jg-Stevan/web-scanner.git",
    "directory": "packages/scanner-core"
  },
  "homepage": "https://jg-stevan.github.io/web-scanner/",
  "bugs": "https://github.com/Jg-Stevan/web-scanner/issues",
  "keywords": [
    "document-scanner",
    "opencv",
    "ocr",
    "pdf-export",
    "edge-detection",
    "image-processing",
    "pwa",
    "browser"
  ],
  "engines": {
    "bun": ">=1.1"
  }
}
