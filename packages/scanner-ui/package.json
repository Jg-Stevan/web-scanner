{
  "name": "@jg-stevan/scanner-ui",
  "version": "0.1.0",
  "description": "Capa React de la base de digitalización: visor táctil ZoomableVisor (pinza anclada, pan con clamps, doble toque, rueda, comparación por pulsación larga, swipe de carrusel y modo card). Componentes puros props+callbacks. Browser-only (consume vía bundler).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./*.tsx": "./src/*.tsx"
  },
  "types": "./src/index.ts",
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bunx tsc --project tsconfig.build.json",
    "publish:stage": "bun run build && bun make-publish-package.mjs",
    "prepublishOnly": "bun run build && bunx tsc --noEmit"
  },
  "peerDependencies": {
    "framer-motion": "^12.23.2",
    "react": "^19.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5"
  }
}
